# Include in nginx http {}. Replace travel.example.com and TLS file locations.
limit_req_zone $binary_remote_addr zone=roam_auth:10m rate=5r/m;
server {
  listen 80;
  server_name travel.example.com;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl;
  server_name travel.example.com;
  ssl_certificate /etc/letsencrypt/live/travel.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/travel.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  client_max_body_size 7m;
  location ~ ^/api/(login|register)$ {
    limit_req zone=roam_auth burst=8 nodelay;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_cookie_flags ROAMSESSION secure httponly samesite=lax;
  }
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_cookie_flags ROAMSESSION secure httponly samesite=lax;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
  }
}

